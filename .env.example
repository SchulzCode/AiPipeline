# Control Center
POSTGRES_PASSWORD=replace-with-a-long-random-password
AIPIPE_SESSION_SECRET=replace-with-at-least-32-random-bytes
AIPIPE_DEV_AUTH=true
# Set dev auth false for real use and allow only your GitHub account.
AIPIPE_ALLOWED_GITHUB_LOGINS=your-github-login
AIPIPE_API_BASE_URL=http://localhost:8000
AIPIPE_WEB_BASE_URL=http://localhost:3000
AIPIPE_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
AIPIPE_WORKER_STALE_SECONDS=300

# GitHub App (required for private GitHub repositories / issue listing / autonomous PR actions)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# base64 of the PEM private key, e.g. `base64 -w0 github-app.pem`
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=

# Agent credentials: configure whichever cloud backend you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Local OpenAI-compatible model server used only by the Qwen backend.
# Docker Desktop workers reach a model server running on the host through
# host.docker.internal. These values are translated to OPENAI_* only inside
# the Qwen subprocess; they do not redirect Codex.
AIPIPE_LOCAL_LLM_BASE_URL=http://host.docker.internal:8080/v1
AIPIPE_LOCAL_LLM_API_KEY=replace-with-local-server-api-key
AIPIPE_LOCAL_LLM_MODEL=qwen-local

# Reproducible worker tool versions used by the Docker image.
CODEX_VERSION=0.147.0
CLAUDE_CODE_VERSION=2.1.232
QWEN_CODE_VERSION=0.21.2
